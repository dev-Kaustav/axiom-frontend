{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/docs", "destination": "https://docs.rook.pm", "permanent": true },
    { "source": "/docs/:path*", "destination": "https://docs.rook.pm/:path*", "permanent": true }
  ],
  "rewrites": [
    { "source": "/request-demo", "destination": "/request-demo/index.html" },
    { "source": "/request-demo/", "destination": "/request-demo/index.html" },
    { "source": "/demo", "destination": "/demo/index.html" }
  ],
  "headers": [
    {
      "source": "/demo/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Cache-Control", "value": "private, no-store" }
      ]
    },
    {
      "source": "/demo",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Cache-Control", "value": "private, no-store" }
      ]
    }
  ]
}
